# Langfuse Environment Configuration Template
# Copy this file to .env and configure the values below

# ============================================
# Port Configuration
# ============================================
WEB_HOST_PORT=19532
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9900

# ============================================
# Container Names
# ============================================
CLICKHOUSE_CONTAINER_NAME=langfuse-clickhouse
WEB_CONTAINER_NAME=langfuse-web
WORKER_CONTAINER_NAME=langfuse-worker

# ============================================
# PostgreSQL Configuration (external service on same server)
# ============================================
# PostgreSQL connection details
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=langfuse

# Generated URLs (do not edit these, they use the variables above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================
# Redis Configuration (external service on same server)
# ============================================
REDIS_HOST=host.docker.internal
REDIS_PORT=19531
REDIS_PASSWORD=your_redis_password

# Generated URL (do not edit, uses variables above)
REDIS_CONNECTION_STRING=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ============================================
# ClickHouse Configuration (new container)
# ============================================
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=AUTO_GENERATED_BY_DEPLOY_SCRIPT
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000

# ============================================
# MinIO/S3 Configuration (external service on same server)
# ============================================
# MinIO connection details (port 9001 is console, 9000 is API)
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=langfuse
MINIO_REGION=auto

# Batch Export
LANGFUSE_S3_BATCH_EXPORT_ENABLED=true
LANGFUSE_S3_BATCH_EXPORT_BUCKET=${MINIO_BUCKET}
LANGFUSE_S3_BATCH_EXPORT_PREFIX=exports/
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=${MINIO_ENDPOINT}
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=${MINIO_ACCESS_KEY}
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=${MINIO_SECRET_KEY}
LANGFUSE_S3_BATCH_EXPORT_REGION=${MINIO_REGION}

# Media Upload
LANGFUSE_S3_MEDIA_UPLOAD_ENABLED=true
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=${MINIO_BUCKET}
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=${MINIO_ENDPOINT}
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=${MINIO_ACCESS_KEY}
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=${MINIO_SECRET_KEY}
LANGFUSE_S3_MEDIA_UPLOAD_REGION=${MINIO_REGION}

# Event Upload
LANGFUSE_S3_EVENT_UPLOAD_ENABLED=true
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=${MINIO_BUCKET}
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=${MINIO_ENDPOINT}
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=${MINIO_ACCESS_KEY}
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=${MINIO_SECRET_KEY}
LANGFUSE_S3_EVENT_UPLOAD_REGION=${MINIO_REGION}

# ============================================
# Security Configuration (auto-generated)
# ============================================
NEXTAUTH_URL=http://localhost:19532
NEXTAUTH_SECRET=AUTO_GENERATED_BY_DEPLOY_SCRIPT
SALT=AUTO_GENERATED_BY_DEPLOY_SCRIPT
ENCRYPTION_KEY=AUTO_GENERATED_BY_DEPLOY_SCRIPT

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
TELEMETRY_ENABLED=true
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# ============================================
# Optional: Initial Setup (uncomment if needed)
# ============================================
# LANGFUSE_INIT_ORG_NAME=My Organization
# LANGFUSE_INIT_PROJECT_NAME=My Project
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_NAME=Admin
# LANGFUSE_INIT_USER_PASSWORD=changeme123
