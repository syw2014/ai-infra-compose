# ============================================================
# Xinference CPU Environment Configuration
# ============================================================

# Timezone
TZ=Asia/Shanghai

# Xinference metadata & registry (mapped to ./volumes/xinference inside container)
XINFERENCE_HOME=/root/.xinference

# Model download source: modelscope (recommended in China) or huggingface
XINFERENCE_MODEL_SRC=modelscope

# Model weight cache directories (set in docker-compose environment section)
# HuggingFace cache -> ./volumes/models/huggingface  (HF_HOME=/root/.cache/huggingface)
# ModelScope cache  -> ./volumes/models/modelscope   (MODELSCOPE_CACHE=/root/.cache/modelscope)
# Recommended: use ./download_model.sh to pre-download models into these directories before starting.

# HuggingFace mirror (only needed when XINFERENCE_MODEL_SRC=huggingface)
# HF_ENDPOINT=https://hf-mirror.com

# Number of CPU threads used by PyTorch (0 = auto-detect)
# OMP_NUM_THREADS=4
# MKL_NUM_THREADS=4
